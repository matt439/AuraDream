{
  "id": "/",
  "name": "AuraDream",
  "short_name": "AuraDream",
  "description": "Local text-to-image generator",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#0b0b0e",
  "theme_color": "#131318",

.venv/
# Local test fixtures, static-checker installations and diagnostic receipts.
/work/
__pycache__/
*.pyc
outputs/
# LoRA adapters: the user's own files, hundreds of MB each. The directory is
# read at run time and created on demand; LOCAL_DIFFUSION_LORAS_DIR moves it.
loras/
*.db
*.db-wal
*.db-shm
*.gallery.lock
bundles/
.bundle-*/
.bundle-import-*/
.bundle-upload-*.part
.local-diffusion-staging/
# Smokes' screenshots, written to the directory the smoke runs from.
/*.png
server.log
server.err
local-diffusion.settings.json
.local-diffusion.settings.*.tmp
local-diffusion.snippets.json
.local-diffusion.snippets.*.tmp
.env
# Local agent state and model files that may sit in a checkout.
.claude/
*.gguf
*.safetensors
*.pth
*.ckpt

# HuggingFace tokens - never commit these
*token*.txt
*.token
hf_token*

  {"expect": "els.mu.disabled && els.gridMu.disabled && els.trueCfg.disabled && !els.negative.disabled"},
  {"expect": "tagVocabularyEnabled && !els.tagHelper.hidden && els.prompt.spellcheck"},
  {"eval": "els.prompt.value = '1boy, green h'; els.prompt.focus(); els.prompt.setSelectionRange(els.prompt.value.length, els.prompt.value.length); els.prompt.dispatchEvent(new Event('input', {bubbles: true}));"},

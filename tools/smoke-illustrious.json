  {"eval": "els.tagsBtn.click();"},
  {"expect": "!els.tagsMenu.hidden && els.tagsMenu.textContent.includes('Quality') && els.tagsMenu.textContent.includes('newest') && els.tagsMenu.textContent.includes('recommended negative') && !els.tagsMenu.querySelector('[data-action=\"recommended-suffix\"]')"},
  {"eval": "els.tagsMenu.querySelector('[data-action=\"recommended-negative\"]').click();"},
  {"expect": "els.negative.value.startsWith('worst quality, comic, multiple views') && els.negative.value.endsWith('extra digits, fewer digits')"},
  {"expect": "els.tagsMenu.textContent.includes('Rating') && [...els.tagsMenu.querySelectorAll('[data-tag]')].some(b => b.dataset.tag === 'general')"},
  {"eval": "[...els.tagsMenu.querySelectorAll('[data-tag]')].find(b => b.dataset.tag === 'general').click();"},
  {"wait": 500},
  {"expect": "els.prompt.value === '1boy, green hair, general' && [...els.tagValidation.querySelectorAll('.tag-check')].every((chip) => chip.classList.contains('valid'))"},
  {"eval": "[...els.tagsMenu.querySelectorAll('[data-tag]')].find(b => b.dataset.tag === 'sensitive').click();"},
  {"wait": 500},
  {"expect": "els.prompt.value === '1boy, green hair, sensitive' && [...els.tagValidation.querySelectorAll('.tag-check')].every((chip) => chip.classList.contains('valid'))"},
  {"eval": "els.tagsBtn.click();"},
  {"expect": "[...els.tiers.children].slice(0, 3).every(b => b.classList.contains('recommended')) && !els.tiers.lastElementChild.classList.contains('recommended')"},
  {"eval": "els.width.value = '1536'; els.height.value = '1536'; syncSize();"},
  {"expect": "!els.sizeHint.classList.contains('warn')"},
  {"eval": "els.width.value = '2048'; els.height.value = '2048'; syncSize();"},
  {"expect": "els.sizeHint.classList.contains('warn') && els.sizeHint.textContent.includes('above the 2.25 MP this checkpoint is documented for') && collect().width === 2048"},

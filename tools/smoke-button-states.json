  {"click":"#btn-more-seeds"},
  {"expect":"!els.moreSeedsDialog.open&&els.galleryError.textContent.length>0"},
  {"eval":"window.__secondary=getComputedStyle(els.models);window.__primary=getComputedStyle(els.generate);"},
  {"expect":"__secondary.backgroundColor!=='rgba(0, 0, 0, 0)'&&__contrast(__secondary.color,__secondary.backgroundColor)>=4.5&&__contrast(__primary.color,__primary.backgroundColor)>=4.5&&__primary.backgroundColor!==__secondary.backgroundColor"},
  {"eval":"(async()=>{const j=await api('/api/generate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:'button state fixture',width:256,height:256,steps:2,seed:50,num_images:2})});await __until(async()=>!['queued','running'].includes((await api('/api/jobs/'+j.job_id)).status));await resetGallery();})()"},
